40 SQL Practice Questions – SH Schema
SELECT + WHERE
From SH.CUSTOMERS, display customer ID, first name, last name, gender, and marital status for all female customers.

SELECT CUST_ID, CUST_FIRST_NAME, CUST_LAST_NAME, CUST_GENDER, CUST_MARITAL_STATUS
FROM SH.CUSTOMERS
WHERE CUST_GENDER = 'F';

From SH.CUSTOMERS, find customers whose last name starts with S and whose year of birth is greater than 1970.

SELECT CUST_ID, CUST_FIRST_NAME, CUST_LAST_NAME, CUST_YEAR_OF_BIRTH
FROM SH.CUSTOMERS
WHERE CUST_LAST_NAME LIKE 'S%'
AND CUST_YEAR_OF_BIRTH > 1970;

From SH.PRODUCTS, display product ID, product name, category, and list price for products whose list price is between 100 and 500.

SELECT PROD_ID, PROD_NAME, PROD_CATEGORY, PROD_LIST_PRICE
FROM SH.PRODUCTS
WHERE PROD_LIST_PRICE BETWEEN 100 AND 500;

From SH.PRODUCTS, find products whose minimum price is less than 50 and whose status is available.

SELECT PROD_ID, PROD_NAME, PROD_MIN_PRICE, PROD_STATUS
FROM SH.PRODUCTS
WHERE PROD_MIN_PRICE < 50
AND PROD_STATUS = 'available';

From SH.SALES, display product ID, customer ID, quantity sold, and amount sold for transactions where the amount sold is greater than 1000.

SELECT PROD_ID, CUST_ID, QUANTITY_SOLD, AMOUNT_SOLD
FROM SH.SALES
WHERE AMOUNT_SOLD > 1000;

From SH.SALES, find transactions where the quantity sold is greater than 2 and the channel ID is 3.

SELECT PROD_ID, CUST_ID, QUANTITY_SOLD, CHANNEL_ID
FROM SH.SALES
WHERE QUANTITY_SOLD > 2
AND CHANNEL_ID = 3;

From SH.CHANNELS, display channel ID and channel description for channels whose description contains the word Direct.

SELECT CHANNEL_ID, CHANNEL_DESC
FROM SH.CHANNELS
WHERE CHANNEL_DESC LIKE '%Direct%';

From SH.PROMOTIONS, display promotion ID, promotion name, cost, and category where promotion cost is greater than 1000.

SELECT PROMO_ID, PROMO_NAME, PROMO_COST, PROMO_CATEGORY
FROM SH.PROMOTIONS
WHERE PROMO_COST > 1000;

From SH.PROMOTIONS, find promotions whose end date is greater than their begin date and whose promotion cost is greater than 500.

SELECT PROMO_ID, PROMO_NAME, PROMO_BEGIN_DATE, PROMO_END_DATE, PROMO_COST
FROM SH.PROMOTIONS
WHERE PROMO_END_DATE > PROMO_BEGIN_DATE
AND PROMO_COST > 500;

From SH.COUNTRIES, display country ID, country name, and region ID for countries belonging to region ID 52790.

SELECT COUNTRY_ID, COUNTRY_NAME, COUNTRY_REGION_ID
FROM SH.COUNTRIES
WHERE COUNTRY_REGION_ID = 52790;

From SH.TIMES, display time ID, day name, calendar month name, and calendar year for dates belonging to the year 2000.

SELECT TIME_ID, DAY_NAME, CALENDAR_MONTH_NAME, CALENDAR_YEAR
FROM SH.TIMES
WHERE CALENDAR_YEAR = 2000;

From SH.TIMES, find all dates where the calendar month name is December and the calendar year is 2001.

SELECT TIME_ID, DAY_NAME, CALENDAR_MONTH_NAME, CALENDAR_YEAR
FROM SH.TIMES
WHERE CALENDAR_MONTH_NAME = 'December'
AND CALENDAR_YEAR = 2001;

From SH.COSTS, display product ID, time ID, unit cost, and unit price where unit price is greater than unit cost.

SELECT PROD_ID, TIME_ID, UNIT_COST, UNIT_PRICE
FROM SH.COSTS
WHERE UNIT_PRICE > UNIT_COST;

From SH.COSTS, find records where unit cost is greater than 100 and unit price is less than 1000.

SELECT PROD_ID, TIME_ID, UNIT_COST, UNIT_PRICE
FROM SH.COSTS
WHERE UNIT_COST > 100
AND UNIT_PRICE < 1000;

From SH.SUPPLEMENTARY_DEMOGRAPHICS, display customer ID, education, occupation, and household size for customers whose household size is greater than 3.

SELECT CUST_ID, EDUCATION, OCCUPATION, HOUSEHOLD_SIZE
FROM SH.SUPPLEMENTARY_DEMOGRAPHICS
WHERE HOUSEHOLD_SIZE > 3;


GROUP BY – DIFFERENT BUSINESS QUESTIONS
Using SH.CUSTOMERS, find the number of customers belonging to each marital status.
SELECT CUST_MARITAL_STATUS, COUNT(*) AS CUSTOMER_COUNT
FROM SH.CUSTOMERS
GROUP BY CUST_MARITAL_STATUS;

Using SH.CUSTOMERS, find the average customer year of birth for each gender.
SELECT CUST_GENDER, AVG(CUST_YEAR_OF_BIRTH) AS AVG_BIRTH_YEAR
FROM SH.CUSTOMERS
GROUP BY CUST_GENDER;

Using SH.PRODUCTS, find the average list price of products in each product category.
SELECT PROD_CATEGORY, AVG(PROD_LIST_PRICE) AS AVG_LIST_PRICE
FROM SH.PRODUCTS
GROUP BY PROD_CATEGORY;

Using SH.PRODUCTS, find the highest minimum price in each product subcategory.
SELECT PROD_SUBCATEGORY, MAX(PROD_MIN_PRICE) AS HIGHEST_MIN_PRICE
FROM SH.PRODUCTS
GROUP BY PROD_SUBCATEGORY;

Using SH.SALES, calculate the total sales amount generated by each channel.
SELECT CHANNEL_ID, SUM(AMOUNT_SOLD) AS TOTAL_SALES
FROM SH.SALES
GROUP BY CHANNEL_ID;

Using SH.SALES, calculate the total quantity sold for each product.
SELECT PROD_ID, SUM(QUANTITY_SOLD) AS TOTAL_QUANTITY
FROM SH.SALES
GROUP BY PROD_ID;

Using SH.SALES, find the average sales amount for each promotion.
SELECT PROMO_ID, AVG(AMOUNT_SOLD) AS AVG_SALES
FROM SH.SALES
GROUP BY PROMO_ID;

Using SH.PROMOTIONS, calculate the total promotion cost for each promotion category.
SELECT PROMO_CATEGORY, SUM(PROMO_COST) AS TOTAL_PROMO_COST
FROM SH.PROMOTIONS
GROUP BY PROMO_CATEGORY;

Using SH.COUNTRIES, count the number of countries belonging to each region.
SELECT COUNTRY_REGION_ID, COUNT(*) AS COUNTRY_COUNT
FROM SH.COUNTRIES
GROUP BY COUNTRY_REGION_ID;

Using SH.COSTS, calculate the average unit cost for each product.
SELECT PROD_ID, AVG(UNIT_COST) AS AVG_UNIT_COST
FROM SH.COSTS
GROUP BY PROD_ID;


